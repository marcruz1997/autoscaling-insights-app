# Configuração do build. Ajuste antes de rodar o ./build.sh.

# Onde as imagens serão publicadas: quay.io/<sua organização ou usuário>
REGISTRY=quay.io/marcruz

# Versão desta publicação (aumente a cada nova versão: 1.0.1, 1.1.0...)
VERSION=1.0.0

# Nome exibido como fornecedor no OperatorHub
PROVIDER="KubeTech Lab"

# Arquitetura dos clusters (ARO e a maioria dos clusters: linux/amd64)
PLATFORM=linux/amd64

# Versões das ferramentas usadas no build
OPM_IMAGE=quay.io/operator-framework/opm:v1.72.0
